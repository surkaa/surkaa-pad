{
  "name": "surkaa-pad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "tsc": "vue-tsc --noEmit",
    "tauri": "tauri",
    "tauri:msi:dev": "tauri dev --config ./src-tauri/tauri.dev.json",
    "tauri:msi:build": "tauri build",
    "tauri:android:dev": "tauri android dev --host 127.0.0.1 --config ./src-tauri/tauri.android-dev.json",
    "tauri:android:build": "tauri android build --target aarch64 --apk true"
  },
  "dependencies": {
    "@quasar/extras": "^1.17.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.6.0",
    "@tauri-apps/plugin-fs": "^2.4.4",
    "@tauri-apps/plugin-geolocation": "^2.3.2",
    "@tauri-apps/plugin-log": "~2.7.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "@tiptap/extension-placeholder": "^3.22.5",
    "@tiptap/extension-task-item": "^3.22.5",
    "@tiptap/extension-task-list": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "@tiptap/vue-3": "^3.22.5",
    "@vueuse/core": "^14.2.1",
    "markdown-it": "^14.3.0",
    "pinia": "^3.0.4",
    "quasar": "^2.18.6",
    "tauri-plugin-native-camera-api": "^0.1.0",
    "uuid": "^13.0.0",
    "vue": "^3.5.13",
    "vue-json-pretty": "^2.6.0",
    "vue-router": "^4.6.3",
    "wavesurfer.js": "^7.12.11"
  },
  "devDependencies": {
    "@quasar/vite-plugin": "^1.10.0",
    "@tauri-apps/cli": "^2",
    "@tiptap/pm": "^3.22.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.0.3",
    "@vitejs/plugin-vue": "^5.2.1",
    "happy-dom": "^20.9.0",
    "sass-embedded": "^1.93.3",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.2",
    "vue-tsc": "^2.1.10"
  }
