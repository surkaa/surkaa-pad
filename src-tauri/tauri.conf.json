{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SurKaa Pad",
  "version": "0.4.10",
  "identifier": "cn.surkaa.pad",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://10.30.21.39:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SurKaa Pad",
        "width": 542,
        "height": 1429,
        "x": 1683,
        "y": 0
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["$TEMP/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
