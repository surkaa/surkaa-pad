{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SurKaa Pad",
  "version": "0.5.6",
  "identifier": "cn.surkaa.pad",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SurKaa Pad"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost attachment: http://attachment.localhost; img-src 'self' asset: http://asset.localhost attachment: http://attachment.localhost https://*.aliyuncs.com; media-src 'self' attachment: http://attachment.localhost https://*.aliyuncs.com",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**/*"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
