{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "core:window:allow-destroy",
    "core:menu:default",
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "store:default",
    "dialog:default",
    "fs:allow-applog-read",
    "fs:allow-write-file",
    "log:default",
    "core:window:allow-close",
    "process:default"
  ]
}
